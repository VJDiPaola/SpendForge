# Application
APP_BASE_URL=http://localhost:3000
# Preview-only server connection for the append-only operation journal. Apply
# migrations/001_provider_operation_journal.sql before enabling any mutation.
# Use a runtime role limited to SELECT and INSERT on the journal table.
DATABASE_URL=
RECOVERY_ENCRYPTION_KEY=
# Server-only Vercel Deployment Protection automation bypass. Required only
# for the x402 buyer to call the protected Preview seller route.
VERCEL_AUTOMATION_BYPASS_SECRET=
DEMO_MODE=fixture
MODEL_PROVIDER=openai
# Optional. Base64 key material, 32 bytes or more, used to sign audit receipts.
# Leave empty to use the published demo key, which lets anyone verify a receipt
# with `npm run verify:receipt` but proves only integrity, never authorship.
# Set this to a secret when receipts need to be attributable to this deployment.
RECEIPT_SIGNING_KEY=
RECEIPT_SIGNING_KEY_ID=

# Rain workshop sandbox - server only
RAIN_BASE_URL=https://api-dev.raincards.xyz/v1
RAIN_API_KEY=
# sessionid is generated ephemerally per scoped-card request; never configure it.
RAIN_USER_ID=
# Optional for list endpoints; the P0 flow uses direct transaction readback.
RAIN_TEAM_ID=
RAIN_CONTRACT_ID=
# Provider-wide and operation-specific mutation gates. Keep false except on the
# single protected Preview deployment approved for that exact operation.
RAIN_MUTATIONS_ENABLED=false
RAIN_FUNDING_ENABLED=false
RAIN_CARD_ISSUANCE_ENABLED=false
RAIN_AUTHORIZATION_ENABLED=false
RAIN_SETTLEMENT_ENABLED=false
RAIN_NORTHSTAR_PROOF_WINDOW_OPEN=false
RAIN_NORTHSTAR_AUTHORIZED_ATTEMPT_ID=
RAIN_NORTHSTAR_RECONCILIATION_WINDOW_OPEN=false
RAIN_NORTHSTAR_RECONCILIATION_ATTEMPT_ID=

# Monad testnet / x402 - server only
MONAD_CHAIN_ID=10143
MONAD_NETWORK=eip155:10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
MONAD_FACILITATOR_URL=https://x402-facilitator.molandak.org
MONAD_X402_PAYMENT_ENABLED=false
MONAD_X402_SELLER_ENABLED=false
MONAD_X402_RESOURCE_URL=
MONAD_X402_SELLER_ADDRESS=
MONAD_X402_AUTHORIZED_ATTEMPT_ID=
MONAD_X402_MAX_AMOUNT_ATOMIC=3000
MONAD_X402_BUYER_PRIVATE_KEY=

# Optional bounded proposal model. A key alone cannot enable a call: the live
# adapter also requires Preview, DEMO_MODE=live, MODEL_PROVIDER=openai, and the
# explicit execution gate. Keep false until a separate API-spend authorization.
OPENAI_API_KEY=
OPENAI_DECISION_MODEL=gpt-5.6-terra
OPENAI_DECISION_ENABLED=false
OPENAI_DECISION_PROOF_WINDOW_OPEN=false
OPENAI_DECISION_AUTHORIZED_ATTEMPT_ID=
